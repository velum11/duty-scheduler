{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "workops",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.port", "8503", "--server.headless", "true"],
      "port": 8503
    },
    {
      "name": "workops-sample-verify",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:DUTY_DATA_MODE='sample'; & .\\.venv\\Scripts\\python.exe -m streamlit run app.py --server.port 8510 --server.headless true"],
      "port": 8510
    }
  ]
}
