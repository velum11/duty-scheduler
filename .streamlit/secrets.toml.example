# 데이터 모드는 반드시 명시적으로 선택합니다: sample 또는 supabase.
[app]
data_mode = "sample"

# Supabase 모드에서는 아래 값을 테스트 프로젝트의 서버 환경에만 설정합니다.
#
# 이 파일을 같은 폴더에 secrets.toml 로 복사한 뒤 값을 채우세요.
# secrets.toml 은 .gitignore 로 커밋에서 제외됩니다.

# [supabase]
# url = "https://xxxxxxxx.supabase.co"
# service_role_key = "your-service-role-key"
# test_project = false

# 접수 알림 메일(modules/mailer.py). [smtp]와 [notify]가 모두 있어야 발송하며,
# 없으면 알림 없이 동작합니다(접수 자체는 영향 없음).
# 지메일은 앱 비밀번호(2단계 인증 필요), 비즈메카는 ezesmtp.bizmeka.com:587.
# [smtp]
# host = "smtp.gmail.com"
# port = 587
# user = "sender@example.com"
# app_password = "app-password"

# [notify]
# to = ["recipient@example.com"]
